# Copy to .env (never commit .env). Any OpenAI-compatible endpoint with tool calling works.
# Option A: GitHub Models
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=<your GitHub PAT>
LLM_MODEL=<a model that supports tool calling>

# Option B: Cloudflare Workers AI
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_API_KEY=<CF API token>
# LLM_MODEL=<a model that supports function calling>
