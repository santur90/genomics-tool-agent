"""Evaluation harness: run tasks, grade, aggregate, write JSON + markdown."""

from __future__ import annotations

import contextlib
import hashlib
import json
import os
import re
import shutil
import statistics
import tempfile
import time
from collections.abc import Iterator
from datetime import datetime
from pathlib import Path
from types import SimpleNamespace
from typing import Any

import yaml

from eval.graders import grade_task
from eval.judge import calibrate, judge_answer
from gta.agent import run_agent
from gta.llm import LLM, LLMError, MockLLM, OpenAICompatLLM, QuotaExhausted

TASKS_VERSION = "1.2"
EVAL_DIR = Path(__file__).resolve().parent
ROOT = EVAL_DIR.parent
RESULTS_DIR = EVAL_DIR / "results"
KNOWLEDGE_FIXTURE = ROOT / "tests" / "fixtures" / "knowledge_mini"
KNOWLEDGE_RAW_FILES = ("ReactomePathways.gmt", "ReactomePathways.txt", "go-basic.obo", "goa_human.gaf")
RESCORE_SUFFIX = ".rescored_v1.2.jsonl"
# Metrics a rescore carries over unchanged: they depend on the live run, or on full tool outputs that the saved
# audit log does not keep (error kinds, numeric values outside result summaries); their graders did not change in v1.2.
RUN_METRICS = {
    "invalid_call_rate",
    "n_steps",
    "n_duplicate_calls",
    "latency_s",
    "tokens",
    "judge_support",
    "numeric_grounding",
    "hallucinated_number_rate",
}
METRICS = [
    "task_success",
    "tool_selection_accuracy",
    "arg_accuracy",
    "invalid_call_rate",
    "hallucinated_number_rate",
    "numeric_grounding",
    "citation_validity",
    "citation_precision",
    "citation_recall",
    "retrieval_used",
    "judge_support",
    "n_steps",
    "n_duplicate_calls",
    "latency_s",
    "tokens",
]


def load_truth() -> dict[str, Any]:
    """Load ground-truth JSON files produced by `make data`."""
    try:
        return {
            "rnaseq": json.loads((ROOT / "data/rnaseq/ground_truth.json").read_text()),
            "vcf": json.loads((ROOT / "data/variants/vcf_truth.json").read_text()),
        }
    except FileNotFoundError as exc:
        raise SystemExit("Ground-truth files missing; run `make data` first.") from exc


def knowledge_store_identity(fixture: Path = KNOWLEDGE_FIXTURE) -> dict[str, str]:
    """Pinned store identity: fixture path relative to the repo root and a checksum of the raw fixture files only."""
    digest = hashlib.sha256()
    for name in sorted(KNOWLEDGE_RAW_FILES):
        digest.update(name.encode() + b"\0" + (fixture / name).read_bytes() + b"\0")
    try:
        rel = fixture.resolve().relative_to(ROOT).as_posix()
    except ValueError:
        rel = str(fixture)
    return {"fixture": rel, "sha256": digest.hexdigest()}


@contextlib.contextmanager
def fixture_knowledge_base() -> Iterator[Path]:
    """Point the knowledge tools at a private copy of the mini fixture so rag tasks have known answers."""
    if not KNOWLEDGE_FIXTURE.is_dir():
        raise SystemExit(f"Knowledge fixture missing: {KNOWLEDGE_FIXTURE}")
    previous = os.environ.get("GTA_KNOWLEDGE_DIR")
    with tempfile.TemporaryDirectory(prefix="gta-eval-kb-") as tmp:
        shutil.copytree(KNOWLEDGE_FIXTURE, tmp, dirs_exist_ok=True)
        os.environ["GTA_KNOWLEDGE_DIR"] = tmp
        try:
            yield Path(tmp)
        finally:
            if previous is None:
                os.environ.pop("GTA_KNOWLEDGE_DIR", None)
            else:
                os.environ["GTA_KNOWLEDGE_DIR"] = previous


QUOTA_MESSAGE = "daily quota exhausted, rerun with --resume tomorrow"
PCT_METRICS = {
    "task_success",
    "tool_selection_accuracy",
    "arg_accuracy",
    "invalid_call_rate",
    "hallucinated_number_rate",
    "numeric_grounding",
    "citation_validity",
    "citation_precision",
    "citation_recall",
    "retrieval_used",
    "judge_support",
}
OPTIONAL_METRICS = {"judge_support"}
HEADERS = {
    "task_success": "success",
    "tool_selection_accuracy": "tool sel.",
    "arg_accuracy": "arg acc.",
    "invalid_call_rate": "invalid calls",
    "hallucinated_number_rate": "halluc. numbers",
    "numeric_grounding": "num. grounding",
    "citation_validity": "citation validity",
    "citation_precision": "citation precision",
    "citation_recall": "citation recall",
    "retrieval_used": "retrieval used",
    "judge_support": "judge support",
    "n_steps": "steps",
    "n_duplicate_calls": "dup. calls",
    "latency_s": "latency (s)",
    "tokens": "tokens",
}


def load_tasks(
    selectors: str | list[str] | None = None, path: Path = EVAL_DIR / "tasks.yaml"
) -> list[dict[str, Any]]:
    """Load tasks, optionally filtered by comma-separated task ids and/or category names."""
    tasks = yaml.safe_load(path.read_text())["tasks"]
    if isinstance(selectors, str):
        selectors = [x.strip() for x in selectors.split(",") if x.strip()]
    if not selectors:
        return tasks
    known = {t["id"] for t in tasks} | {t["category"] for t in tasks}
    unknown = [x for x in selectors if x not in known]
    if unknown:
        raise SystemExit(f"Unknown task id or category: {unknown}")
    return [t for t in tasks if t["id"] in selectors or t["category"] in selectors]


def _mean_sd(values: list[float]) -> dict[str, float]:
    return {"mean": statistics.fmean(values), "sd": statistics.stdev(values) if len(values) > 1 else 0.0}


def aggregate(rows: list[dict[str, Any]], repeats: int | None = None) -> dict[str, Any]:
    """Mean±sd across repeats (per-repeat means), overall and per category."""

    def over_repeats(subset: list[dict[str, Any]]) -> dict[str, dict[str, float]]:
        reps = sorted({r["repeat"] for r in subset})
        out: dict[str, dict[str, float]] = {}
        for m in METRICS:
            per_repeat = []
            for k in reps:
                vals = [r["metrics"].get(m) for r in subset if r["repeat"] == k]
                vals = [v for v in vals if v is not None]  # None = metric not applicable to that task
                if vals:
                    per_repeat.append(statistics.fmean(vals))
            if per_repeat:
                out[m] = _mean_sd(per_repeat)
        return out

    cats = sorted({r["category"] for r in rows})
    return {
        "overall": over_repeats(rows),
        "by_category": {c: over_repeats([r for r in rows if r["category"] == c]) for c in cats},
    }


def _make_llm(task: dict[str, Any], mock: bool) -> LLM:
    if mock:
        spec = task["mock"]
        return MockLLM.from_calls(spec.get("calls", []), spec["answer"])
    return OpenAICompatLLM()


def _fmt(metric: str, m: dict[str, float] | None) -> str:
    if m is None:
        return "–"
    if metric in PCT_METRICS:
        return f"{m['mean'] * 100:.0f}±{m['sd'] * 100:.0f}%"
    if metric == "tokens":
        return f"{m['mean']:.0f}±{m['sd']:.0f}"
    return f"{m['mean']:.2f}±{m['sd']:.2f}"


def _table(first_col: str, rows: dict[str, dict[str, dict[str, float]]]) -> list[str]:
    cols = [m for m in METRICS if m not in OPTIONAL_METRICS or any(m in agg for agg in rows.values())]
    lines = [
        f"| {first_col} | " + " | ".join(HEADERS[m] for m in cols) + " |",
        "|" + "---|" * (len(cols) + 1),
    ]
    for name, agg in rows.items():
        lines.append(f"| {name} | " + " | ".join(_fmt(m, agg.get(m)) for m in cols) + " |")
    return lines


def write_summary(results_dir: Path = RESULTS_DIR) -> None:
    """Render summary.md from the latest result of every real (non-mock) model, one section per tasks version.

    Scores from different task versions are never merged into the same table.
    """
    latest: dict[str, dict[str, dict[str, Any]]] = {}
    for f in sorted(results_dir.glob("*.json")):
        if f.name.startswith("mock_"):
            continue
        rep = json.loads(f.read_text())
        if rep.get("model") != "mock":
            latest.setdefault(rep.get("tasks_version", "1.0"), {})[rep["model"]] = rep
    rescored = _latest_rescored(results_dir)
    if not latest and not rescored:
        (results_dir / "summary.md").write_text("_No real-model results yet. Run `gta eval --repeats 3`._\n")
        return
    lines = ["Mean±sd across repeats (per-repeat means). – = metric not applicable to the tasks."]
    for version in sorted(latest, reverse=True):
        models = latest[version]
        lines += ["", f"## Tasks v{version}", ""]
        lines += _table(
            "model", {f"{m} (n={r['repeats']})": r["aggregate"]["overall"] for m, r in models.items()}
        )
        for model, rep in models.items():
            lines += ["", f"### {model} (tasks v{version}): by category", ""]
            lines += _table("category", rep["aggregate"]["by_category"])
            store = rep.get("knowledge_store")
            if store:
                lines += [
                    "",
                    f"Pinned knowledge store: `{store['fixture']}` (raw-file sha256 `{store['sha256']}`)",
                ]
    if rescored:
        lines += [
            "",
            "## v1.1 rescored with v1.2 graders",
            "",
            "Offline rescore of the saved v1.1 rows (no LLM calls); the v1.1 tables above are unchanged.",
            "",
        ]
        lines += _table(
            "model",
            {f"{m} (n={rows[-1]['repeat'] + 1})": aggregate(rows)["overall"] for m, rows in rescored.items()},
        )
    (results_dir / "summary.md").write_text("\n".join(lines) + "\n")


def _latest_rescored(results_dir: Path) -> dict[str, list[dict[str, Any]]]:
    """Latest rescored rows per real model."""
    out: dict[str, list[dict[str, Any]]] = {}
    for f in sorted(results_dir.glob(f"*{RESCORE_SUFFIX}")):
        rows = _read_partial(f)
        if rows and rows[0].get("model") != "mock":
            rows.sort(key=lambda r: r["repeat"])
            out[rows[0]["model"]] = rows
    return out


def _saved_result(call: dict[str, Any]) -> dict[str, Any]:
    """Tool result for regrading: the full saved output text when present, else the logged summary/error."""
    if call.get("result_text") is not None:
        return {"result_text": call["result_text"]}
    if not call.get("ok", True):
        return {"error": call.get("error")}
    return {"summary": call.get("result_summary") or {}}


def _rescore_row(row: dict[str, Any], task: dict[str, Any], truth: dict[str, Any]) -> dict[str, Any]:
    """Rebuild a run from the saved audit log and regrade it; run-dependent metrics are carried over."""
    calls = [
        SimpleNamespace(
            name=c["name"],
            args=c.get("args") or {},
            is_error=not c.get("ok", True),
            error_kind=None,
            result=_saved_result(c),
        )
        for c in row.get("calls", [])
    ]
    result = SimpleNamespace(
        answer=row.get("answer", ""), calls=calls, n_steps=0, n_duplicate_calls=0, latency_s=0.0,
        prompt_tokens=0, completion_tokens=0,
    )  # fmt: skip
    new = grade_task(task, result, truth)  # type: ignore[arg-type]
    old = row.get("metrics", {})
    return {k: (old.get(k) if k in RUN_METRICS else v) for k, v in new.items()}


def rescore(
    path: Path, tasks_path: Path = EVAL_DIR / "tasks.yaml", truth: dict[str, Any] | None = None
) -> tuple[Path, list[dict[str, Any]]]:
    """Recompute graded metrics offline from a saved .jsonl, writing `<name>.rescored_v1.2.jsonl` beside it.

    The input is never modified. Returns the output path and one diff record per row.
    """
    path = Path(path)
    name = path.name
    for suffix in (RESCORE_SUFFIX, ".done.jsonl", ".partial.jsonl", ".jsonl"):
        if name.endswith(suffix):
            name = name.removesuffix(suffix)
            break
    out = path.with_name(name + RESCORE_SUFFIX)
    if out.resolve() == path.resolve():
        raise SystemExit(f"Refusing to overwrite the input file: {path}")
    rows = _read_partial(path)
    if not rows:
        raise SystemExit(f"No rows in {path}")
    tasks = {t["id"]: t for t in load_tasks(path=tasks_path)}
    truth = truth if truth is not None else load_truth()
    diffs, new_rows = [], []
    for row in rows:
        task = tasks.get(row["id"])
        if task is None:
            new_rows.append(row)
            diffs.append(
                {
                    "id": row["id"],
                    "repeat": row["repeat"],
                    "old": None,
                    "new": None,
                    "changed": ["task not in tasks.yaml"],
                }
            )
            continue
        metrics = _rescore_row(row, task, truth)
        old = row["metrics"]
        changed = [
            k for k in metrics
            if (old.get(k) is None) != (metrics[k] is None)
            or (metrics[k] is not None and abs(float(old[k]) - float(metrics[k])) > 1e-9)
        ]  # fmt: skip
        new_rows.append({**row, "metrics": metrics, "rescored_with": "1.2"})
        diffs.append(
            {
                "id": row["id"],
                "repeat": row["repeat"],
                "old": old.get("task_success"),
                "new": metrics["task_success"],
                "changed": changed,
                "has_result_text": all("result_text" in c for c in row.get("calls", [])),
            }
        )
    out.write_text("".join(json.dumps(r) + "\n" for r in new_rows))
    if out.resolve().parent == RESULTS_DIR.resolve():
        write_summary(RESULTS_DIR)
    return out, diffs


def _read_partial(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def _find_partial(results_dir: Path, slug: str) -> Path | None:
    candidates = sorted(results_dir.glob(f"{slug}_*.partial.jsonl"))
    return candidates[-1] if candidates else None


def _finalize(
    rows: list[dict[str, Any]], model: str, partial: Path, n_tasks: int, judge: dict[str, Any] | None = None
) -> dict[str, Any]:
    repeats = max((r["repeat"] for r in rows), default=-1) + 1
    report = {
        "model": model,
        "tasks_version": TASKS_VERSION,
        "knowledge_store": knowledge_store_identity(),
        "date": datetime.now().isoformat(timespec="minutes"),
        "repeats": repeats,
        "n_tasks": n_tasks,
        "n_rows": len(rows),
        "judge": judge,
        "aggregate": aggregate(rows) if rows else {},
        "tasks": rows,
    }
    if rows:
        final = partial.with_name(partial.name.removesuffix(".partial.jsonl") + ".json")
        final.write_text(json.dumps(report, indent=2))
        write_summary(partial.parent)
    return report


def run_eval(
    mock: bool = False,
    repeats: int = 1,
    tasks: str | list[str] | None = None,
    sleep: float = 0.0,
    resume: bool = False,
    results_dir: Path = RESULTS_DIR,
    category: str | None = None,
    judge: bool = False,
    judge_llm: LLM | None = None,
) -> dict[str, Any]:
    """Run tasks `repeats` times, appending each finished row to a .partial.jsonl; write final JSON + summary at the end.

    A fully completed run renames its partial file to .done.jsonl, so only incomplete partials are resumed.
    With `judge`, an LLM judge is calibrated on eval/judge_calibration.yaml (agreement is reported) and then adds a
    per-answer `judge_support` metric. Knowledge tools always run against the mini fixture.
    """
    truth, selected = load_truth(), load_tasks(tasks)
    if category:
        selected = [t for t in selected if t["category"] == category]
        if not selected:
            raise SystemExit(f"No tasks in category '{category}'.")
    model = "mock" if mock else os.environ.get("LLM_MODEL", "")
    if not model:
        raise SystemExit("LLM_MODEL is not set (use --model or .env).")
    slug = re.sub(r"[^\w.-]+", "_", model)
    results_dir.mkdir(parents=True, exist_ok=True)
    partial = (
        _find_partial(results_dir, slug) if resume else None
    ) or results_dir / f"{slug}_{datetime.now():%Y%m%d-%H%M}.partial.jsonl"
    rows = [r for r in _read_partial(partial) if r.get("tasks_version", "1.0") == TASKS_VERSION]
    done = {(r["id"], r["repeat"]) for r in rows}
    quota_hit, failed, ran = False, [], 0
    judge_client = (
        (judge_llm or OpenAICompatLLM(model=os.environ.get("LLM_JUDGE_MODEL") or None)) if judge else None
    )
    judge_report = calibrate(judge_client) if judge_client is not None else None
    store_identity = knowledge_store_identity()
    with fixture_knowledge_base():
        try:
            for k in range(repeats):
                for task in selected:
                    if (task["id"], k) in done:
                        continue
                    if ran and sleep:
                        time.sleep(sleep)
                    ran += 1
                    result = run_agent(task["prompt"], _make_llm(task, mock))
                    if result.stopped == "llm_error":
                        failed.append(f"{task['id']}#{k}")  # not recorded, so --resume retries it
                        continue
                    metrics = grade_task(task, result, truth)
                    if judge_client is not None:
                        evidence = json.dumps([c.result for c in result.calls])
                        try:
                            metrics["judge_support"] = judge_answer(judge_client, result.answer, evidence)
                        except LLMError:
                            metrics["judge_support"] = None
                    row = {
                        "id": task["id"],
                        "category": task["category"],
                        "repeat": k,
                        "model": model,
                        "tasks_version": TASKS_VERSION,
                        "knowledge_store": store_identity,
                        "termination_reason": result.termination_reason,
                        "verifier": getattr(result, "verifier", "off"),
                        "verifier_issues": getattr(result, "verifier_issues", []),
                        "verifier_issues_after": getattr(result, "verifier_issues_after", []),
                        "answer_before_revision": getattr(result, "answer_before_revision", None),
                        "n_revisions": getattr(result, "n_revisions", 0),
                        "extra_llm_calls": getattr(result, "extra_llm_calls", 0),
                        "answer": result.answer,
                        "tools_called": [c.name for c in result.calls],
                        "calls": [c.to_log() for c in result.calls],
                        "metrics": metrics,
                    }
                    with open(partial, "a") as fh:
                        fh.write(json.dumps(row) + "\n")
                    rows.append(row)
        except QuotaExhausted:
            quota_hit = True
    report = _finalize(rows, model, partial, len(selected), judge_report)
    done = {(r["id"], r["repeat"]) for r in rows}
    complete = (
        not quota_hit and not failed and all((t["id"], k) in done for t in selected for k in range(repeats))
    )
    if complete and partial.exists():
        finished = partial.with_name(partial.name.removesuffix(".partial.jsonl") + ".done.jsonl")
        partial.rename(finished)
        partial = finished
    report.update(quota_exhausted=quota_hit, failed=failed, partial_file=str(partial), complete=complete)
    return report


def main() -> None:
    """Entry point: python -m eval.run_eval (same options as `gta eval`)."""
    import argparse

    from gta.llm import load_env

    ap = argparse.ArgumentParser()
    ap.add_argument("--mock", action="store_true")
    ap.add_argument("--model")
    ap.add_argument("--repeats", type=int, default=1)
    ap.add_argument("--sleep", type=float, default=0.0)
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--tasks")
    ap.add_argument("--category")
    ap.add_argument("--judge", action="store_true")
    a = ap.parse_args()
    load_env()
    if a.model:
        os.environ["LLM_MODEL"] = a.model
    report = run_eval(
        mock=a.mock,
        repeats=a.repeats,
        tasks=a.tasks,
        sleep=a.sleep,
        resume=a.resume,
        category=a.category,
        judge=a.judge,
    )
    if report["quota_exhausted"]:
        print(QUOTA_MESSAGE)


if __name__ == "__main__":
    main()
